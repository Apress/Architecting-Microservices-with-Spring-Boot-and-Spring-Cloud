# Eureka Configuration Examples
# Copy this file to .env and configure your environment-specific values

# Eureka Server Credentials
EUREKA_USERNAME=chargeroute
EUREKA_PASSWORD=Admin123!

# Eureka Server Location
EUREKA_HOSTNAME=localhost
EUREKA_PORT=8761

# For Production Environments:
# EUREKA_USERNAME=production-user
# EUREKA_PASSWORD=secure-production-password
# EUREKA_HOSTNAME=eureka.chargeroute.com
# EUREKA_PORT=8761